{
  "name": "@rcrsr/rill-cli",
  "version": "0.20.0",
  "description": "CLI tools for the rill scripting language",
  "license": "MIT",
  "author": "Andre Bremer",
  "type": "module",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "keywords": [
    "rill",
    "cli",
    "scripting",
    "exec",
    "eval",
    "build"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js"
    }
  },
  "bin": {
    "rill": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=12"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install --force",
    "bootstrap": "bash scripts/bootstrap.sh",
    "build": "tsc --build",
    "build:dev": "tsc --build tsconfig.dev.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "rill-test-rules",
    "check": "pnpm run check:standards && pnpm run build && pnpm run check:types && pnpm run check:lint && pnpm run check:format && pnpm run test && pnpm run test:rules && pnpm run check:deps",
    "check:types": "tsc --noEmit",
    "check:lint": "oxlint --config .oxlintrc.json src/ tests/",
    "check:format": "oxfmt --check",
    "check:deps": "knip",
    "check:standards": "rill-check-standards",
    "fix:lint": "oxlint --config .oxlintrc.json --fix src/ tests/",
    "fix:format": "oxfmt",
    "prepublishOnly": "node scripts/check-no-local-specifiers.mjs"
  },
  "dependencies": {
    "@rcrsr/rill": "~0.21.0",
    "@rcrsr/rill-config": "~0.21.0",
    "@rcrsr/rill-language-service": "~0.21.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@rcrsr/rill": "~0.21.0",
    "@rcrsr/rill-config": "~0.21.0",
    "@rcrsr/rill-language-service": "~0.21.0"
  },
  "devDependencies": {
    "@rcrsr/rill": "~0.21.0",
    "@rcrsr/rill-config": "~0.21.0",
    "@rcrsr/rill-dev": "^0.2.5",
    "@rcrsr/rill-ext-datetime": "~0.21.0",
    "@rcrsr/rill-language-service": "~0.21.0",
    "@types/node": "^26.5.0",
    "knip": "^6.35.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill-cli.git"
  },
  "homepage": "https://github.com/rcrsr/rill-cli",
  "bugs": {
    "url": "https://github.com/rcrsr/rill-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
