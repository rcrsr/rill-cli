{
  "name": "@rcrsr/rill-cli",
  "version": "0.23.0",
  "description": "CLI tools for the rill scripting language",
  "license": "MIT",
  "author": "Andre Bremer",
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "keywords": [
    "rill",
    "cli",
    "scripting",
    "exec",
    "eval",
    "build"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js"
    }
  },
  "bin": {
    "rill": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=12"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install --force",
    "bootstrap": "bash scripts/bootstrap.sh",
    "build": "tsc --build",
    "build:dev": "tsc --build tsconfig.dev.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "rill-test-rules",
    "check": "pnpm run check:standards && pnpm run build && pnpm run check:types && pnpm run check:lint && pnpm run check:format && pnpm run test && pnpm run test:rules && pnpm run check:deps",
    "check:types": "tsc --noEmit",
    "check:lint": "oxlint --type-aware --config .oxlintrc.json src/ tests/",
    "check:format": "oxfmt --check",
    "check:deps": "knip",
    "check:standards": "rill-check-standards",
    "fix:lint": "oxlint --type-aware --config .oxlintrc.json --fix src/ tests/",
    "fix:format": "oxfmt",
    "prepublishOnly": "node scripts/check-no-local-specifiers.mjs"
  },
  "dependencies": {
    "@rcrsr/rill": "~0.23.0",
    "@rcrsr/rill-config": "~0.23.0",
    "@rcrsr/rill-language-service": "~0.23.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@rcrsr/rill": "~0.23.0",
    "@rcrsr/rill-config": "~0.23.0",
    "@rcrsr/rill-language-service": "~0.23.0"
  },
  "devDependencies": {
    "@rcrsr/rill": "~0.23.0",
    "@rcrsr/rill-config": "~0.23.0",
    "@rcrsr/rill-dev": "^0.3.0",
    "@rcrsr/rill-ext-datetime": "~0.23.0",
    "@rcrsr/rill-language-service": "~0.23.0",
    "@types/node": "^26.6.6",
    "knip": "^6.44.1",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill-cli.git"
  },
  "homepage": "https://github.com/rcrsr/rill-cli",
  "bugs": {
    "url": "https://github.com/rcrsr/rill-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
